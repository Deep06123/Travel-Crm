# Travel Booking CRM — production environment for a Hostinger VPS.
#
# Copy to /srv/travel-crm/shared/.env on the server and fill in. It is read by
# systemd (EnvironmentFile=) and by the Prisma CLI during a release.
#
#   install -m 600 -o deploy -g deploy deploy/env.production.example \
#     /srv/travel-crm/shared/.env
#
# chmod 600 matters: AUTH_SECRET and the database password are both in here.
#
# systemd parses this itself, not through a shell. Surrounding quotes are
# stripped, but there is no `export`, no $VARIABLE expansion and no command
# substitution — a value containing one of those is taken literally.

# --- Runtime ----------------------------------------------------------------
NODE_ENV="production"
LOG_LEVEL="info"
# Drives date bucketing in reports. Set it to where the agency actually works,
# not to the server's clock.
BUSINESS_TIMEZONE="Asia/Kolkata"

# --- Database ---------------------------------------------------------------
# MySQL runs on the same box and listens on loopback only, so no TLS parameter
# and no ?ssl=true. Use the `mysql://` scheme even though the driver underneath
# is mariadb: that is what the Prisma CLI requires.
#
# Percent-encode any of : / ? # [ ] @ in the password, or the URL parser will
# read it as a delimiter — a password ending in @ silently becomes part of the
# hostname.
DATABASE_URL="mysql://travel_crm:CHANGE_ME@127.0.0.1:3306/travel_crm"

# Leave DIRECT_URL unset. It exists for serverless hosts whose connection
# pooler cannot hold the session state that DDL requires; here the one string
# is already direct.

# Connections held by the single application process. Unset means 10, which is
# right for one host against MySQL's default max_connections of 151.
# DB_POOL_MAX="10"

# --- Sessions ---------------------------------------------------------------
# Generate on the server, and never reuse the development value:
#   openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# The canonical origin, exactly as a browser sees it — scheme included, no
# trailing slash. It must match the certificate and the nginx server_name.
#
# Also read at BUILD time: next.config.ts puts this host in the Server Action
# allow-list, and `output: "standalone"` freezes that into the bundle. Set it
# before building, not only before starting.
AUTH_URL="https://crm.example.com"

# Defaults are sensible; set only to change them.
# SESSION_MAX_AGE_SECONDS="28800"
# LOGIN_MAX_ATTEMPTS="5"
# LOGIN_LOCKOUT_SECONDS="900"

# --- Document storage -------------------------------------------------------
# A VPS has a real, persistent filesystem, so the local driver is the right one
# here — "blob" exists for Vercel, where it is the only thing that works.
#
# The root sits outside the release directory on purpose: a release is replaced
# wholesale on every deploy, and anything under public/ is served to anyone by
# URL, bypassing the permission check in /api/admin/documents/[id]/view. The
# env schema rejects a public/ path outright.
#
# systemd grants write access to exactly this path (ReadWritePaths= in
# travel-crm.service) — change one and change the other.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="/srv/travel-crm/shared/storage"

# --- Outbound customer email ------------------------------------------------
# "none" transmits nothing. Confirmation and ticketing notices are still
# recorded, as SUPPRESSED with the reason, so an operator can see an email was
# owed and not sent. Nothing breaks; customers simply hear nothing.
#
# Before real bookings go in, set this to "smtp".
#
# Hostinger blocks outbound SMTP on new VPS instances by default — port 25
# always, and often 465/587 until you ask support to open them. Use a provider
# over port 587 (SES, SendGrid, Postmark, Mailgun) rather than sending direct;
# deliverability from a fresh VPS IP is poor regardless.
MAIL_DRIVER="none"
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="587"          # 587 = STARTTLS. Use 465 with SMTP_SECURE="true".
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_FROM="Travel CRM <bookings@example.com>"
# MAIL_REPLY_TO="support@example.com"

# --- First run only ---------------------------------------------------------
# Read by `npm run db:seed`, and only when no administrator exists yet.
# Leave INITIAL_ADMIN_PASSWORD unset: the seed generates a strong one and
# prints it exactly once. It is stored as a bcrypt digest and is not
# recoverable afterwards — capture it from the terminal.
#
# Remove these three once the first administrator can sign in.
INITIAL_ADMIN_EMAIL="you@example.com"
INITIAL_ADMIN_NAME="Your Name"
INITIAL_ADMIN_USERNAME="superadmin"
