# Copy to `.env` and fill in. Never commit the filled-in copy.
#
# Every value here is read server-side only. Nothing in this file is prefixed
# NEXT_PUBLIC_, so none of it reaches the browser bundle.

# --- Database ---------------------------------------------------------------
# REQUIRED. A MySQL 8.0+ connection string. There is no fallback: the
# application cannot serve a page without it.
#
# Use the `mysql://` scheme even though the driver underneath is mariadb —
# that is what the Prisma CLI requires, and the application translates it.
#
# On a managed provider (PlanetScale, RDS, Aiven) use the POOLED endpoint if
# one is offered: serverless opens a connection per instance and will exhaust
# a direct limit. Append `?ssl=true` where the provider requires TLS.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Direct, non-pooled connection, used only by the Prisma CLI for migrations and
# seeding. Set it when the pooled endpoint above cannot run DDL — a proxy that
# multiplexes connections cannot hold the session state schema changes need.
# Leave unset on a single-host deployment, where one string serves both.
# DIRECT_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# --- Sessions ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Session idle lifetime in seconds. Default 8 hours.
SESSION_MAX_AGE_SECONDS="28800"

# Failed sign-ins before an account is temporarily locked, and the lockout
# length in seconds.
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_SECONDS="900"

# --- Runtime ----------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="info"
BUSINESS_TIMEZONE="UTC"

# --- First-run provisioning -------------------------------------------------
# Read only by `npm run db:seed`, and only when no administrator exists yet.
# Leave INITIAL_ADMIN_PASSWORD unset to have a strong one generated and printed
# exactly once. The account is always flagged to change it at first sign-in.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_NAME="Super Admin"
INITIAL_ADMIN_USERNAME="superadmin"
# INITIAL_ADMIN_PASSWORD=""

# --- Document storage -------------------------------------------------------
# "local" writes to disk and suits a single host. STORAGE_LOCAL_ROOT must NOT
# live under public/ — anything there is served to anyone by URL.
#
# "blob" stores objects in Vercel Blob with private access, and is the only
# workable choice on a serverless platform: there the filesystem is read-only
# apart from /tmp, and /tmp is not shared between invocations, so a document
# written during an upload is gone before the request that reads it back.
# BLOB_READ_WRITE_TOKEN is injected automatically once a Blob store is linked
# to the Vercel project; set it by hand only when running the blob driver
# locally.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./storage"
# BLOB_READ_WRITE_TOKEN=""

# --- Outbound customer email ---
# Sent to the customer when a booking is confirmed and when it is ticketed.
#
# "none" (the default) attempts nothing: the Notification row is still written,
# as SUPPRESSED with the reason, so an operator can see an email was owed and
# was not sent. It never reports SENT for a message that did not leave.
#
# "smtp" sends for real, and then requires SMTP_HOST and MAIL_FROM. Works with
# SES, SendGrid, Postmark, Mailgun and Gmail, and with a local catcher such as
# Mailpit on 127.0.0.1:1025 for development.
MAIL_DRIVER="none"
# SMTP_HOST="email-smtp.eu-west-1.amazonaws.com"
# Port 587 with SMTP_SECURE=false uses STARTTLS; 465 needs SMTP_SECURE=true.
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_FROM="Travel CRM <bookings@example.com>"
# MAIL_REPLY_TO="support@example.com"
