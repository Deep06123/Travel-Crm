{
  "name": "travel-booking-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/start-local-mysql.sh ensure && next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "vercel-build": "bash scripts/vercel-build.sh",
    "start": "next start",
    "hostinger:setup": "bash scripts/hostinger-setup.sh",
    "hostinger:deploy": "bash scripts/hostinger-deploy.sh",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "admin:reset-password": "tsx --env-file=.env scripts/reset-admin-password.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:db": "bash scripts/start-local-mysql.sh start",
    "dev:db:stop": "bash scripts/start-local-mysql.sh stop",
    "smoke": "tsx scripts/smoke-test.mts",
    "dev:db:reset": "bash scripts/start-local-mysql.sh reset",
    "db:sample": "tsx scripts/seed-sample-data.mts",
    "db:sample:clear": "tsx scripts/clear-sample-data.mts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-table": "9.3.1",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/sanitize-html": "^2.16.2",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.59.0",
    "mariadb": "^3.5.4",
    "next": "16.4.2",
    "nodemailer": "^10.2.0",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^26.0.0",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.5"
  }
}
